<Window x:Class="RestauranteWPF.Views.CozinhaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RestauranteWPF.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CozinhaViewModel}"
        Title="Restaurante - Tela da Cozinha"
        Width="1100" Height="740" MinWidth="900" MinHeight="560"
        WindowStartupLocation="Manual" Left="80" Top="60"
        Background="{StaticResource CorFundo}"
        Foreground="{StaticResource CorTexto}"
        FontFamily="Segoe UI" FontSize="14">

    <Window.Resources>

        <!-- Modelo visual de UM pedido na cozinha (reutilizado nas 3 colunas) -->
        <DataTemplate x:Key="CardPedido" DataType="{x:Type vm:PedidoCardViewModel}">
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <!-- Pedido #15 ............ 22:15 -->
                    <Grid>
                        <TextBlock Text="{Binding Titulo}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Horario}" Style="{StaticResource TextoSecundario}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Mesa 12 -->
                    <TextBlock Text="{Binding MesaTexto}" FontWeight="SemiBold"
                               Foreground="{StaticResource CorPrimaria}" Margin="0,2,0,10"/>

                    <!-- Itens: 2x X-Burger / 1x Batata Frita ... -->
                    <ItemsControl ItemsSource="{Binding Itens}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="15" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Status: NOVO -->
                    <Border Style="{StaticResource SeloStatus}">
                        <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" Style="{StaticResource TextoSelo}"/>
                    </Border>

                    <!-- Botão que avança o status (verde quando o pedido está pronto) -->
                    <Button Content="{Binding TextoBotao}"
                            Command="{Binding AvancarStatusCommand}"
                            Height="38" Margin="0,12,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BotaoPrimario}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="PRONTO">
                                        <Setter Property="Background" Value="{StaticResource CorSucesso}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Texto exibido quando uma coluna está vazia -->
        <Style x:Key="ColunaVazia" TargetType="TextBlock" BasedOn="{StaticResource TextoSecundario}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- título -->
            <RowDefinition Height="Auto"/> <!-- mensagem de erro -->
            <RowDefinition Height="*"/>    <!-- colunas -->
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Tela da Cozinha" Style="{StaticResource TituloTela}"/>
            <TextBlock Text="Novos pedidos aparecem aqui automaticamente."
                       Style="{StaticResource TextoSecundario}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Erro de comunicação com o banco (oculto quando vazio) -->
        <Border Grid.Row="1" Background="#FBE4E2" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Mensagem}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" Foreground="{StaticResource CorErro}" TextWrapping="Wrap"/>
        </Border>

        <!-- Três colunas, uma por status -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Coluna NOVOS ===== -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource TituloSecao}"
                           Text="{Binding PedidosNovos.Count, StringFormat='Novos ({0})'}"/>
                <TextBlock DockPanel.Dock="Top" Text="Nenhum pedido novo.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ColunaVazia}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PedidosNovos.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PedidosNovos}" ItemTemplate="{StaticResource CardPedido}"/>
                </ScrollViewer>
            </DockPanel>

            <!-- ===== Coluna EM PREPARO ===== -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource TituloSecao}"
                           Text="{Binding PedidosPreparando.Count, StringFormat='Em preparo ({0})'}"/>
                <TextBlock DockPanel.Dock="Top" Text="Nenhum pedido em preparo.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ColunaVazia}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PedidosPreparando.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PedidosPreparando}" ItemTemplate="{StaticResource CardPedido}"/>
                </ScrollViewer>
            </DockPanel>

            <!-- ===== Coluna PRONTOS ===== -->
            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource TituloSecao}"
                           Text="{Binding PedidosProntos.Count, StringFormat='Prontos ({0})'}"/>
                <TextBlock DockPanel.Dock="Top" Text="Nenhum pedido pronto.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ColunaVazia}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PedidosProntos.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PedidosProntos}" ItemTemplate="{StaticResource CardPedido}"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
