<Application x:Class="RestauranteWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Não usamos StartupUri: as janelas são abertas no App.xaml.cs
        depois que a conexão com o Supabase estiver pronta.
    -->
    <Application.Resources>

        <!-- ============ PALETA (cores neutras) ============ -->
        <SolidColorBrush x:Key="CorFundo" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="CorSuperficie" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CorBorda" Color="#D9DDE3"/>
        <SolidColorBrush x:Key="CorTexto" Color="#1F2933"/>
        <SolidColorBrush x:Key="CorTextoSecundario" Color="#5F6B7A"/>
        <SolidColorBrush x:Key="CorPrimaria" Color="#2F5D8A"/>
        <SolidColorBrush x:Key="CorSucesso" Color="#2E7D4F"/>
        <SolidColorBrush x:Key="CorErro" Color="#B3261E"/>
        <SolidColorBrush x:Key="CorPlaceholder" Color="#ECEEF1"/>

        <!-- ============ CARD ============ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CorSuperficie}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CorBorda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- ============ TEXTOS ============ -->
        <Style x:Key="TituloTela" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="TituloSecao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="TextoSecundario" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ============ BOTÕES ============ -->
        <!-- Botão base: plano, cantos arredondados, sem efeitos exagerados -->
        <Style x:Key="BotaoBase" TargetType="Button">
            <Setter Property="Background" Value="#E6E9ED"/>
            <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Feedback visual simples ao passar o mouse / clicar -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fundo" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <!-- Botão desabilitado fica "apagado" -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fundo" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
            <Setter Property="Background" Value="{StaticResource CorPrimaria}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="BotaoQuantidade" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <!-- ============ SELO DE STATUS ============ -->
        <!-- A cor muda automaticamente conforme a propriedade Status -->
        <Style x:Key="SeloStatus" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#ECEFF1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="NOVO">
                    <Setter Property="Background" Value="#E3ECF6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="PREPARANDO">
                    <Setter Property="Background" Value="#FBF0DC"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="PRONTO">
                    <Setter Property="Background" Value="#E3F2E8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextoSelo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="NOVO">
                    <Setter Property="Foreground" Value="{StaticResource CorPrimaria}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="PREPARANDO">
                    <Setter Property="Foreground" Value="#8A5A12"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="PRONTO">
                    <Setter Property="Foreground" Value="{StaticResource CorSucesso}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ CAIXA DE MENSAGEM (sucesso/erro) ============ -->
        <!-- Fica oculta quando Mensagem está vazia; vermelha quando é erro -->
        <Style x:Key="CaixaMensagem" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#E3F2E8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                    <Setter Property="Background" Value="#FBE4E2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Mensagem}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
